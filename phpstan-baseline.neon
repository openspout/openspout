parameters:
	ignoreErrors:
		-
			message: '#^Instanceof between OpenSpout\\Common\\Entity\\Comment\\TextRun and OpenSpout\\Common\\Entity\\Comment\\TextRun will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: src/Common/Entity/Comment/Comment.php

		-
			message: '#^Call to function is_int\(\) with int\<0, max\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Common/Entity/Row.php

		-
			message: '#^Comparison operation "\>" between 0 and int\<0, max\> is always false\.$#'
			identifier: greater.alwaysFalse
			count: 1
			path: src/Common/Entity/Row.php

		-
			message: '#^Instanceof between OpenSpout\\Common\\Entity\\Cell and OpenSpout\\Common\\Entity\\Cell will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: src/Common/Entity/Row.php

		-
			message: '#^Result of \|\| is always false\.$#'
			identifier: booleanOr.alwaysFalse
			count: 1
			path: src/Common/Entity/Row.php

		-
			message: '#^Parameter \#1 \$cells of class OpenSpout\\Common\\Entity\\Row constructor expects array\<int\<0, max\>, OpenSpout\\Common\\Entity\\Cell\>, array\<int, OpenSpout\\Common\\Entity\\Cell\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Reader/CSV/RowIterator.php

		-
			message: '#^Return type \(OpenSpout\\Common\\Entity\\Row\|null\) of method OpenSpout\\Reader\\CSV\\RowIterator\:\:current\(\) should be covariant with return type \(OpenSpout\\Common\\Entity\\Row\) of method Iterator\<mixed,OpenSpout\\Common\\Entity\\Row\>\:\:current\(\)$#'
			identifier: method.childReturnType
			count: 1
			path: src/Reader/CSV/RowIterator.php

		-
			message: '#^Cannot access offset 0 on callable\(\)\: mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Reader/Common/XMLProcessor.php

		-
			message: '#^Cannot access offset 1 on callable\(\)\: mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Reader/Common/XMLProcessor.php

		-
			message: '#^Return type \(OpenSpout\\Common\\Entity\\Row\|null\) of method OpenSpout\\Reader\\RowIteratorInterface\:\:current\(\) should be covariant with return type \(OpenSpout\\Common\\Entity\\Row\) of method Iterator\<mixed,OpenSpout\\Common\\Entity\\Row\>\:\:current\(\)$#'
			identifier: method.childReturnType
			count: 1
			path: src/Reader/RowIteratorInterface.php

		-
			message: '#^Dynamic call to static method XMLReader\:\:open\(\)\.$#'
			identifier: staticMethod.dynamicCall
			count: 1
			path: src/Reader/Wrapper/XMLReader.php

		-
			message: '#^Offset string\|null might not exist on array\{A\: 0, B\: 1, C\: 2, D\: 3, E\: 4, F\: 5, G\: 6, H\: 7, \.\.\.\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: src/Reader/XLSX/Helper/CellHelper.php

		-
			message: '#^Parameter \#1 \$cells of method OpenSpout\\Common\\Entity\\Row\:\:withCells\(\) expects array\<int\<0, max\>, OpenSpout\\Common\\Entity\\Cell\>, non\-empty\-array\<int, OpenSpout\\Common\\Entity\\Cell\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Reader/XLSX/RowIterator.php

		-
			message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(OpenSpout\\Common\\Entity\\Cell\)\: mixed\)\|null, Closure\(OpenSpout\\Common\\Entity\\Cell\\BooleanCell\|OpenSpout\\Common\\Entity\\Cell\\DateIntervalCell\|OpenSpout\\Common\\Entity\\Cell\\DateTimeCell\|OpenSpout\\Common\\Entity\\Cell\\EmptyCell\|OpenSpout\\Common\\Entity\\Cell\\FormulaCell\|OpenSpout\\Common\\Entity\\Cell\\NumericCell\|OpenSpout\\Common\\Entity\\Cell\\StringCell\)\: string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Writer/CSV/Writer.php

		-
			message: '#^Short ternary operator is not allowed\. Use null coalesce operator if applicable or consider using long ternary\.$#'
			identifier: ternary.shortNotAllowed
			count: 1
			path: src/Writer/ODS/Manager/WorksheetManager.php

		-
			message: '#^Comparison operation "\<" between int\<0, max\> and 0 is always false\.$#'
			identifier: smaller.alwaysFalse
			count: 1
			path: src/Writer/XLSX/Entity/SheetView.php

		-
			message: '#^Parameter \#1 \$red of static method OpenSpout\\Common\\Entity\\Style\\Color\:\:rgb\(\) expects int\<0, 255\>, int given\.$#'
			identifier: argument.type
			count: 1
			path: tests/Common/Entity/Style/ColorTest.php

		-
			message: '#^Parameter \#2 \$green of static method OpenSpout\\Common\\Entity\\Style\\Color\:\:rgb\(\) expects int\<0, 255\>, int given\.$#'
			identifier: argument.type
			count: 1
			path: tests/Common/Entity/Style/ColorTest.php

		-
			message: '#^Parameter \#3 \$blue of static method OpenSpout\\Common\\Entity\\Style\\Color\:\:rgb\(\) expects int\<0, 255\>, int given\.$#'
			identifier: argument.type
			count: 1
			path: tests/Common/Entity/Style/ColorTest.php

		-
			message: '#^Method OpenSpout\\Reader\\CSV\\SpoutTestStream\:\:url_stat\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: tests/Reader/CSV/SpoutTestStream.php

		-
			message: '#^Dynamic call to static method XMLReader\:\:XML\(\)\.$#'
			identifier: staticMethod.dynamicCall
			count: 1
			path: tests/Reader/Wrapper/XMLReaderTest.php

		-
			message: '#^Parameter \$freezeRow of class OpenSpout\\Writer\\XLSX\\Entity\\SheetView constructor expects int\<0, max\>, \-1 given\.$#'
			identifier: argument.type
			count: 1
			path: tests/Reader/XLSX/Entity/SheetViewTest.php

		-
			message: '#^Method OpenSpout\\Reader\\XLSX\\Manager\\StyleManagerTest\:\:getStyleManagerMock\(\) has parameter \$customNumberFormats with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: tests/Reader/XLSX/Manager/StyleManagerTest.php

		-
			message: '#^Method OpenSpout\\Reader\\XLSX\\Manager\\StyleManagerTest\:\:getStyleManagerMock\(\) has parameter \$styleAttributes with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: tests/Reader/XLSX/Manager/StyleManagerTest.php

		-
			message: '#^Method OpenSpout\\Reader\\XLSX\\ReaderTest\:\:getAllRowsForFile\(\) has parameter \$options with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: tests/Reader/XLSX/ReaderTest.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertCount\(\) with arguments 3, array\{non\-empty\-string\} and ''There should be 3…'' will always evaluate to false\.$#'
			identifier: staticMethod.impossibleType
			count: 1
			path: tests/Writer/ODS/Manager/Style/StyleRegistryTest.php

		-
			message: '#^Readonly property OpenSpout\\Writer\\Common\\AbstractOptions\:\:\$SHOULD_CREATE_NEW_SHEETS_AUTOMATICALLY is assigned outside of its declaring class\.$#'
			identifier: property.readOnlyAssignOutOfClass
			count: 1
			path: tests/Writer/ODS/WriterTest.php

